// Prisma schema for Beat For Trip.
//
// Production and local development both use PostgreSQL (Prisma Postgres).
// DATABASE_URL must be a postgresql:// connection string.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Beat {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String
  genre       String
  bpm         Int
  key         String
  duration    Int // seconds
  price       Float
  currency    String   @default("EUR") // always EUR — enforced in app code, never client-supplied

  coverUrl    String   @default("") // public URL, e.g. /covers/xxx.jpg
  previewUrl  String   @default("") // public URL, e.g. /previews/xxx.mp3
  fileKey     String   @default("") // protected storage key, resolved only after a paid order

  status      String   @default("unpublished") // "published" | "unpublished"

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders      Order[]

  @@index([status])
}

model Order {
  id                      String    @id @default(cuid())
  type                    String    @default("BEAT") // "BEAT" | "EXCLUSIVE_BEAT"
  email                   String
  customerName            String? // collected for EXCLUSIVE_BEAT orders; regular Beat orders leave this empty

  // Optional because EXCLUSIVE_BEAT orders have no Beat row to point to —
  // the exclusive item doesn't exist as a catalog product yet.
  beatId                  String?
  beat                    Beat?     @relation(fields: [beatId], references: [id])

  amount                  Float
  currency                String

  paymentProvider         String // "mock" | "tribute" | "paypalych"
  paymentId               String? // external payment/session id from the provider

  status                  String    @default("pending") // pending | paid | failed | refunded

  // PayPalych refund/chargeback webhook event IDs — idempotency key + audit
  // trail (a repeat delivery of the same event ID is a no-op). A confirmed
  // chargeback also sets status to "refunded" — there's no separate UI state
  // for it — so chargebackId is what distinguishes it from a voluntary refund.
  refundId                String?
  chargebackId            String?

  // EXCLUSIVE_BEAT orders only: fulfillment progress after payment, since the
  // beat itself is produced after the purchase. Unused (null) for regular
  // Beat orders, which are fully resolved by `status` + the download token.
  fulfillmentStatus       String? // "PAID" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED"

  downloadToken           String?   @unique
  downloadTokenExpiresAt  DateTime?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([email])
  @@index([paymentId])
  @@index([status])
  @@index([type])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Website CMS. One row per editable field per locale — never one giant JSON
// blob — so drafts, publishing and locale overrides all work at field
// granularity. `page`/`section`/`key` mirror lib/site-content-registry.ts.
model SiteContent {
  id         String   @id @default(cuid())
  page       String
  section    String
  key        String
  locale     String
  value      String? // published — read by the public site
  draftValue String? // admin-only — never exposed to the public site

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, section, key, locale])
  @@index([page, locale])
}
