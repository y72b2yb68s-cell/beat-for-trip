# Database — SQLite works out of the box for local dev. The path is resolved
# relative to prisma/schema.prisma, so "file:./dev.db" resolves to prisma/dev.db.
# For production, switch prisma/schema.prisma datasource provider to "postgresql"
# and set this to a postgresql:// connection string. No model changes required.
DATABASE_URL="file:./dev.db"

# Public base URL of the app (used in metadata, absolute links, and payment callback URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin panel (/admin/login) credentials — required, no default is provided.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Tribute payment provider.
# Leave both empty to keep using the built-in mock payment provider — the app
# detects a missing TRIBUTE_API_KEY automatically and needs no code changes to
# switch once real credentials are available.
TRIBUTE_API_KEY=
TRIBUTE_WEBHOOK_SECRET=
