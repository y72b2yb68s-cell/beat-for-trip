# Database — PostgreSQL (Prisma Postgres in production, via Vercel).
# Set this to a postgresql:// connection string. For local development,
# point it at your own local/dev Postgres instance — do not use the
# production URL from Vercel here.
DATABASE_URL="postgresql://user:password@localhost:5432/beat_for_trip?schema=public"

# Public base URL of the app (used in metadata, absolute links, and payment callback URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin panel (/admin/login) credentials — required, no default is provided.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Random secret used to sign the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Tribute payment provider.
# Leave both empty to keep using the built-in mock payment provider — the app
# detects a missing TRIBUTE_API_KEY automatically and needs no code changes to
# switch once real credentials are available.
TRIBUTE_API_KEY=
TRIBUTE_WEBHOOK_SECRET=

# PayPalych payment provider.
# Leave both empty to keep using the built-in mock payment provider (or
# Tribute, if that's configured) — set both to switch to PayPalych, no code
# changes needed. PayPalych uses one API token for both outbound API auth
# (Bearer) and inbound webhook signature verification — see lib/payments/paypalych.ts.
PAYPALYCH_SHOP_ID=
PAYPALYCH_API_TOKEN=
# Optional override — only set this if your shop's API base URL differs from
# the default (https://paypalych.com/api/v1/). A trailing slash is not
# required; the app normalizes it either way.
PAYPALYCH_API_BASE_URL=
